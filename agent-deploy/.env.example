# Copy these into the Railway dashboard (Variables tab) or a real .env.
# NEVER commit a real private key.

# Service wallet keypair: JSON array of 64 bytes, or a base58 secret key.
# Generate a FRESH keypair for hosted runs (do not reuse your local one):
#   node -e "console.log(JSON.stringify(Array.from(require('@solana/web3.js').Keypair.generate().secretKey)))"
AGENT_PRIVATE_KEY=[paste-your-freshly-generated-keypair-array]

# The DAMM v2 pool this agent earns on and buys back (defaults to canonical AGNT).
AGENT_MARKET_POOL=Aw25voQXKLu5pswW5srxnfxyaLGQjxZRRFZmz7QEkREw
AGENT_TOKEN_MINT=7AZLo4es23WHtseYrhH2ScPJ1LtRb8Qk5pPGCqyRiji9
AGENT_TOKEN_SYMBOL=AGNT

# Share of every payment swapped back into the token (5000 = 50%).
AGENT_BUYBACK_BPS=5000

# LLM (Groq free tier works; any OpenAI-compatible endpoint does).
AGENT_LLM_ENDPOINT=https://api.groq.com/openai/v1
AGENT_LLM_API_KEY=gsk_your_key
AGENT_LLM_MODEL=openai/gpt-oss-20b
