# Public beta mode. This build is intentionally limited to test assets.
VITE_APP_MODE=public-devnet-beta

# Solana network used by the Meteora DBC integration.
VITE_SOLANA_DEVNET_RPC=https://api.devnet.solana.com
VITE_SOLANA_FAUCET_URL=https://faucet.solana.com/

# Meteora DBC program is deployed at this address on Solana devnet.
# The app uses this value for explorer links; pool creation still requires a valid config.
VITE_METEORA_DBC_PROGRAM=dbcij3LWUppWqq96dh6gJWwBifmcGfLSB5D4DuSMaqN

# Required before creating a virtual pool. These are partner/token-specific public keys.
VITE_METEORA_DBC_CONFIG=
VITE_METEORA_BASE_MINT=

# Optional pool metadata.
VITE_METEORA_POOL_NAME=AgentBond
VITE_METEORA_POOL_SYMBOL=AGNT
VITE_METEORA_POOL_URI=https://agentbond.local/metadata.json

# Optional existing pools used by the local read-only lifecycle inspector.
VITE_METEORA_DAMM_V2_POOL=
VITE_METEORA_DLMM_POOL=
VITE_METEORA_DAMM_V2_CONFIG=
VITE_METEORA_DLMM_ACTIVE_BIN_ID=0
VITE_METEORA_DLMM_BIN_RANGE=10
VITE_METEORA_DLMM_TOKEN_X_AMOUNT=0.1
VITE_METEORA_DLMM_TOKEN_Y_AMOUNT=0.1

# Safety gate: writes remain disabled until the public Devnet transaction flow is reviewed.
VITE_METEORA_ENABLE_TRANSACTIONS=false

# Explicit network guard; only devnet is currently supported.
VITE_SOLANA_NETWORK=devnet
